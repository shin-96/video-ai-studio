# Copy to .env.local OR paste the keys in the app's Settings page (stored locally in data/settings.json, gitignored).
# Keys are only ever read on the server, never sent to the browser.

OPENAI_API_KEY=
GEMINI_API_KEY=

# Model names are configurable because providers retire models often.
OPENAI_CHAT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
